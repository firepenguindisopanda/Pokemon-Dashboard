# Copy to .env for local development. Never commit .env.
#
# ── Secrets ──
# FLASK_SECRET_KEY signs the session cookie.
# JWT_SECRET_KEY signs the access and refresh tokens — anyone who knows it can
# mint a valid token for ANY user, so treat it like a password database.
#
# Generate each one separately:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# With DEBUG=false the app REFUSES TO START if either value is a placeholder,
# is shorter than 32 characters, or is empty. That check is deliberate: a
# silently unprotected production app is worse than one that fails to boot.
FLASK_SECRET_KEY="replace-with-a-generated-value"
JWT_SECRET_KEY="replace-with-a-generated-value"

# ── Core ──
# DATABASE_URL wins when set — this is what the host injects in production.
# Leave it unset locally to use the SQLite fallback below.
# A legacy "postgres://" scheme is rewritten to "postgresql://" automatically.
#   DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
SQLALCHEMY_DATABASE_URI="sqlite:///data.db"
DEBUG="true"                           # MUST be "false" in production

# Connection pooling — applied to server-backed databases only; SQLite ignores
# them. pool_pre_ping is what survives Neon closing idle connections.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_PRE_PING="true"

# ── JWT ──
JWT_ACCESS_TOKEN_EXPIRES_HOURS=0.25    # 15 minutes
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7
JWT_TOKEN_LEEWAY_SECONDS=30            # clock skew tolerance
JWT_COOKIE_SECURE="false"              # MUST be "true" in production (HTTPS)
JWT_COOKIE_CSRF_PROTECT="true"         # cookie auth is forgeable without this

# ── Sessions / Redis ──
# Native Redis URL — use the rediss:// scheme for TLS (Upstash requires it).
# NOTE: Upstash's UPSTASH_REDIS_REST_URL / _REST_TOKEN are a different,
# HTTP-based API and will NOT work here. Copy the redis-cli connection string
# from the Upstash console and change "redis://" to "rediss://".
# Required when DEBUG=false: without it, sessions fall back to a signed cookie
# that the client can read, exposing quiz answers and arena state.
#   REDIS_URL="rediss://default:<password>@<host>.upstash.io:6379"

# ── Rate limiting ──
# Applies to /login, /signup and /api/auth/refresh, keyed by client IP.
# Counters use REDIS_URL when set, otherwise in-memory (per-process, lost on
# restart — fine for development, not for production).
RATE_LIMIT_AUTH="20 per minute"
RATE_LIMIT_ENABLED="true"

# ── CORS ──
# Comma-separated. "*" is REJECTED when DEBUG=false — auth rides in cookies,
# so a wildcard exposes authenticated endpoints to any site.
#   CORS_ORIGINS="https://your-app.onrender.com"
CORS_ORIGINS="*"

# ── Analytics / ML ──
ANALYTICS_AUTO_INITIALIZE="true"
RANDOM_SEED=42
