# Copy to .env for local development. Never commit .env.
#
# ── Secrets ──
# FLASK_SECRET_KEY signs the session cookie.
# JWT_SECRET_KEY signs the access and refresh tokens — anyone who knows it can
# mint a valid token for ANY user, so treat it like a password database.
#
# Generate each one separately:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# With DEBUG=false the app REFUSES TO START if either value is a placeholder,
# is shorter than 32 characters, or is empty. That check is deliberate: a
# silently unprotected production app is worse than one that fails to boot.
FLASK_SECRET_KEY="replace-with-a-generated-value"
JWT_SECRET_KEY="replace-with-a-generated-value"

# ── Core ──
SQLALCHEMY_DATABASE_URI="sqlite:///data.db"
DEBUG="true"                           # MUST be "false" in production

# ── JWT ──
JWT_ACCESS_TOKEN_EXPIRES_HOURS=0.25    # 15 minutes
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7
JWT_TOKEN_LEEWAY_SECONDS=30            # clock skew tolerance
JWT_COOKIE_SECURE="false"              # MUST be "true" in production (HTTPS)
JWT_COOKIE_CSRF_PROTECT="false"        # to be enabled in T12

# ── CORS ──
CORS_ORIGINS="*"                       # restrict to the deployed origin in production

# ── Analytics / ML ──
ANALYTICS_AUTO_INITIALIZE="true"
RANDOM_SEED=42
