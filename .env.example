# ── Flask Core ──
FLASK_SECRET_KEY="change-me-production"
SQLALCHEMY_DATABASE_URI="sqlite:///data.db"
DEBUG="true"

# ── JWT Authentication ──
JWT_SECRET_KEY="change-me-production"
JWT_ACCESS_TOKEN_EXPIRES_HOURS=0.25    # 15 minutes (was 15h)
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7       # 7 days (NEW)
JWT_TOKEN_LEEWAY_SECONDS=30            # 30s clock skew tolerance (NEW)
JWT_COOKIE_SECURE="false"              # Set "true" for production HTTPS
JWT_COOKIE_CSRF_PROTECT="false"

# ── CORS ──
CORS_ORIGINS="*"

# ── Analytics / ML ──
ANALYTICS_AUTO_INITIALIZE="true"
RANDOM_SEED=42
