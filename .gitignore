.DS_Store
.env
# Holds REAL production credentials despite the .example name.
.env.local.example
.env.*.local
*.pyc
*.pyo
env/
venv/
.venv/
# NOT `env*`: that pattern has no slash, so git matches it against every
# basename at any depth — which silently excluded `migrations/env.py`.
# Alembic cannot run without that file, so `flask db upgrade` failed on
# every fresh checkout while working perfectly for anyone who already had
# it on disk. Caught by the first real Render deploy. The three directory
# entries above already cover virtualenvs.
dist/
build/
*.egg
*.egg-info/
.tox/
.cache/
.pytest_cache/
.idea/
docs/_build/
.vscode
/node_modules
# Coverage reports
htmlcov/
.coverage
.coverage.*
*,cover

instance/
__pycache__/

# Runtime artifacts
App/data.db
# Model artifacts are built by `flask train`, not committed. They are
# environment-specific: the cache key is a hash of the seeded data.
App/models_cache/*.joblib
App/models_cache/manifest.json

.playwright-mcp/
tasks/
